# Copy to backend/.env and change the secrets.

# PostgreSQL from the root docker-compose.yml (read by Prisma)
DATABASE_URL=postgresql://chefly:chefly_password@localhost:5432/chefly

# JWT access tokens (shared/utils/jwt.ts, shared/src/jwt.ts, shared/middleware/auth.ts, chat socket auth)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# Refresh tokens: shared/utils/jwt.ts reads REFRESH_TOKEN_SECRET, shared/src/jwt.ts reads JWT_REFRESH_SECRET
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Ports (these are the defaults used when a variable is missing)
PORT_GATEWAY=3000
PORT_AUTH=3001
PORT_USER=3002
PORT_BOOKING=3003
PORT_CHAT=3004
PORT_PAYMENT=3005
PORT_NOTIFICATION=3006

# Origin allowed by CORS in the gateway and the chat socket: set it to the frontend URL
CLIENT_URL=http://localhost:8081

# Paymob (payment service); leave empty to run without payments
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
