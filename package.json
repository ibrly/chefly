{
  "name": "chefly",
  "version": "1.0.0",
  "description": "Chef marketplace platform - connecting chefs with clients",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm:dev:frontend\" \"pnpm:dev:backend\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm --filter frontend build && pnpm --dir backend build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter frontend storybook"
  },
  "keywords": [
    "chef",
    "marketplace",
    "react-native",
    "strapi",
    "expo"
  ],
  "author": "Ebrahim Soliman",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "prisma": "^6.18.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0"
  }
}
